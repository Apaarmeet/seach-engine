# Copy to .env and fill in. The .env file is gitignored.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   ./target/release/api --port 8091 --static-dir frontend/dist
#
# Both are optional. With neither set the resolver still runs on its own
# sources — hostname guessing, DNS verification, OpenStreetMap and Wikidata.

# Web index for long-tail recall. https://serper.dev — 2,500 free credits.
SERPER_API_KEY=

# Language model. https://openrouter.ai
# Must be a NON-reasoning model: deepseek-v4-flash and qwen3.7-flash spend
# their entire token budget on hidden reasoning and return null content.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
