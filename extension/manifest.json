{
  "manifest_version": 3,
  "name": "rsearch Guide",
  "version": "0.1.0",
  "description": "Spotlights the control you need, step by step, across pages.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://localhost:8091/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
